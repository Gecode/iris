# Caches and build output
.cache/
target/
build/
dist/
node_modules/
# The Python spec builder package, not build output
!/python/python/gecode_iris/build/

# Python
__pycache__/
.venv/
*.egg-info/
# The extension that maturin develop builds into the source package
/python/python/gecode_iris/*.so
/python/python/gecode_iris/*.pyd

# TypeScript: the WebAssembly module and glue that npm run build generates
/typescript/wasm/
# The test build that npm test generates, with the fault-injection module
/typescript/test-build/
# Local state of the workerd smoke test's wrangler dev
/typescript/test/smoke/workerd/.wrangler/

# Gradle
.gradle/
.kotlin/

# macOS
.DS_Store

# Untracked logo concepts (see brand/README.md)
/brand/concepts/
