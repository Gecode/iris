>format dimacs-cnf
#^^^^^^ source.iris meta.format.iris keyword.control.iris
#      ^ source.iris meta.format.iris
#       ^^^^^^^^^^ source.iris meta.format.iris entity.name.section.iris
>
>comment "c"
#^^^^^^^ source.iris keyword.control.iris
#       ^ source.iris
#        ^ source.iris string.quoted.double.iris punctuation.definition.string.begin.iris
#         ^ source.iris string.quoted.double.iris
#          ^ source.iris string.quoted.double.iris punctuation.definition.string.end.iris
>stop "%"                    # SATLIB files end with "%" and "0"
#^^^^ source.iris keyword.control.iris
#    ^ source.iris
#     ^ source.iris string.quoted.double.iris punctuation.definition.string.begin.iris
#      ^ source.iris string.quoted.double.iris
#       ^ source.iris string.quoted.double.iris punctuation.definition.string.end.iris
#        ^^^^^^^^^^^^^^^^^^^^ source.iris
#                            ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.iris comment.line.number-sign.iris
>line "p cnf {vars:0..gecode.int_max} {clauses:0..}"
#^^^^ source.iris meta.line.iris keyword.control.iris
#    ^ source.iris meta.line.iris
#     ^ source.iris meta.line.iris string.quoted.double.pattern.iris punctuation.definition.string.begin.iris
#      ^^^^^^ source.iris meta.line.iris string.quoted.double.pattern.iris
