#                                                  ^ source.iris meta.line.iris string.quoted.double.pattern.iris punctuation.definition.string.end.iris
>repeat clauses {
#^^^^^^ source.iris keyword.control.iris
#      ^ source.iris
#       ^^^^^^^ source.iris variable.other.iris
#              ^ source.iris
