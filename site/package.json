{
  "name": "iris-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && astro dev",
    "build": "npm run prepare:assets && astro build",
    "preview": "astro preview",
