    "astro": "7.3.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "html-validate": "10.17.0",
    "parse5": "7.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.156.1"
