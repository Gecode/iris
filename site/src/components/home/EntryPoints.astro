---
const entries = [
  { heading: 'Introduction', copy: 'How a reader spec describes a format, shown on a small file read from the command line.', link: 'Read the introduction', href: '/introduction/', border: 'border-t-iris-green' },
  { heading: 'Format library', copy: 'Reader specs for benchmark formats, with sample inputs, the data they produce, and rejected inputs. Each case can be downloaded.', link: 'Browse the formats', href: '/formats/', border: 'border-t-iris-blue' },
  { heading: 'Command-line tool', copy: 'Check a reader spec, read an input as JSON or MiniZinc data, or list the instances in a file.', link: 'CLI documentation', href: '/tools/cli/', border: 'border-t-iris-orange' },
];
---
<section class="iris-entry-points grid gap-8" aria-label="Explore Iris">
  {entries.map(entry => <div class:list={['border-t-4 pt-5', entry.border]}>
    <h2 class="font-display text-2xl leading-8 tracking-[-0.025em]">{entry.heading}</h2>
    <p class="my-4">{entry.copy}</p>
    <a class="inline-flex min-h-11 items-center text-iris-link underline underline-offset-4" href={entry.href}>{entry.link}</a>
  </div>)}
</section>
