---
import { formatBySlug, caseById } from '../../data/formats';
import ExamplePane from './ExamplePane.astro';
import ExampleTerminal from './ExampleTerminal.astro';
const format = formatBySlug('dimacs-cnf');
const example = caseById(format, 'literal-out-of-range');
if (example.result.kind !== 'error') throw new Error('Expected the DIMACS error case to fail');
const code = JSON.parse(example.result.json).code;
---
<section aria-labelledby="error-title">
  <h2 id="error-title" class="iris-section-title">When the input does not fit</h2>
  <p class="mb-6">This file declares three variables but uses literal 4. Iris reports the input position and the reader-spec statement that rejected it.</p>
  <div class="min-w-0 border border-iris-border border-s-4 border-s-iris-red bg-iris-surface">
    <ExamplePane source={example.input.text} href={example.downloads.input} label="literal-out-of-range · input" exampleKey={`${format.id}/${example.id}`} representation="input" compact />
    <p class="m-0 border-t border-iris-border px-4 py-3 font-mono text-sm text-iris-red"><code data-example={`${format.id}/${example.id}`} data-representation="error-code" data-final-lf="kept">{code}</code></p>
    <ExampleTerminal example={example} formatId={format.id} error />
    <div class="flex flex-wrap gap-4 px-4 py-3 text-sm">
      <a class="text-iris-link underline underline-offset-4" href={example.downloads['error.json']} download>Download error JSON</a>
      <a class="text-iris-link underline underline-offset-4" href={example.downloads.case} download>Download full case</a>
    </div>
  </div>
</section>
