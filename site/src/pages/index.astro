---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Home from '../components/home/Home.astro';
const base = import.meta.env.BASE_URL;
---
<StarlightPage hasSidebar={true} frontmatter={{
  title: 'Iris',
  description: 'Iris is a specification language for structured text formats. A reader spec describes a format, and Iris reads each input into named, typed data.',
  template: 'splash',
  tableOfContents: false,
  prev: false,
  next: false,
  hero: {
    title: 'A specification language for structured text formats',
    tagline: 'Iris is a specification language for structured text formats. A reader spec describes a format, and Iris reads each input into named, typed data.',
    actions: [
      { text: 'Introduction', link: `${base}introduction/`, variant: 'primary' },
      { text: 'Explore formats', link: '#formats', variant: 'secondary' },
    ],
  },
}}><Home /></StarlightPage>
