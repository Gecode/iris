---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
const base = import.meta.env.BASE_URL;
---
<StarlightPage hasSidebar={true} frontmatter={{
  title: 'Iris',
  description: 'Describe a text format in a reader spec and read its data.',
  template: 'splash',
  tableOfContents: false,
  prev: false,
  next: false,
  hero: {
    title: 'Read instance files with Iris.',
    tagline: 'Describe a text format in a reader spec and read its data.',
    actions: [
      { text: 'Introduction', link: `${base}introduction/`, variant: 'primary' },
      { text: 'Format library', link: `${base}formats/`, variant: 'secondary' },
    ],
  },
}} />
