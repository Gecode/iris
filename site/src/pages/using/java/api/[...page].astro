---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
// Generated during every build by scripts/prepare-java-api.mjs.
import reference from '../../../../generated/java-api.json';

export function getStaticPaths() {
  return reference.pages.map(page => ({ params: { page: page.slug || undefined }, props: { page } }));
}
const { page } = Astro.props;
---
<StarlightPage hasSidebar={true} headings={page.headings} frontmatter={{
  title: page.title,
  description: `${page.title} of the iris Java library.`,
  editUrl: false, prev: false, next: false,
}}>
  <p class="max-w-[68ch]">
    Javadoc {reference.javadoc} generates this <a href="/using/java/api/">reference</a> during each
    site build from the exported packages and the annotation processor. The <a href="/using/java/">Java guide</a> shows the API in use.
  </p>
  <div class="iris-java-api min-w-0 max-w-[76ch]" data-java-api set:html={page.html} />
</StarlightPage>
