---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
// Generated during every build by scripts/prepare-java-api.mjs.
import reference from '../../../../generated/kotlin-api.json';

export function getStaticPaths() {
  return reference.pages.map(page => ({ params: { page: page.slug || undefined }, props: { page } }));
}
const { page } = Astro.props;
// The spec builder of dev.gecode.iris.kotlin.build has its pages below build/.
const builder = page.slug === 'build' || page.slug.startsWith('build/');
---
<StarlightPage hasSidebar={true} headings={page.headings} frontmatter={{
  title: page.title,
  description: `${page.title} of the iris Kotlin ${builder ? 'spec builder' : 'extensions'}.`,
  editUrl: false, prev: false, next: false,
}}>
  {builder ? (
    <p class="max-w-[68ch]">
      Dokka {reference.dokka} generates this reference of the Kotlin spec builder during each
      site build from the Kotlin sources, and its <a href="/using/java/kotlin-api/build/">summary</a> lists
      every class and function. The <a href="/using/java/#in-kotlin">guide</a> shows the builder in
      use, the <a href="/using/java/api/build/">Java builder's reference</a> covers the handles,
      types and expressions it shares, and the <a href="/using/java/kotlin-api/">extensions</a> read
      the data.
    </p>
  ) : (
    <p class="max-w-[68ch]">
      Dokka {reference.dokka} generates this <a href="/using/java/kotlin-api/">reference</a> during
      each site build from the Kotlin sources. The <a href="/using/java/#kotlin">guide</a> shows the
      extensions in use, the <a href="/using/java/api/">Java API reference</a> covers the types
      they extend, and the spec builder's <a href="/using/java/kotlin-api/build/">reference</a> covers <code>dev.gecode.iris.kotlin.build</code>.
    </p>
  )}
  <div class="iris-kotlin-api min-w-0 max-w-[76ch]" data-kotlin-api set:html={page.html} />
</StarlightPage>
