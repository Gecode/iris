{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": ["dist/**", "wasm/**"],
  "overrides": [
    {
      "files": ["test/**/*.test.ts"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    }
  ]
}
