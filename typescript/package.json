{
  "name": "gecode-iris",
  "version": "0.1.0",
  "description": "Read text instance files with Iris reader specs, through the Rust reader compiled to WebAssembly",
  "homepage": "https://iris.gecode.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gecode/iris.git",
    "directory": "typescript"
  },
  "files": [
    "dist",
    "wasm/iris_js.js",
    "wasm/iris_js_bg.wasm",
    "wasm/iris_js_inline.js",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/workerd.js",
      "edge-light": "./dist/workerd.js",
      "node": "./dist/node.js",
      "browser": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./inline": {
      "types": "./dist/index.d.ts",
      "default": "./dist/inline.js"
    },
    "./manual": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build/manual.d.ts",
      "workerd": "./dist/build/workerd.js",
      "edge-light": "./dist/build/workerd.js",
      "node": "./dist/build/node.js",
      "browser": "./dist/build/browser.js",
      "default": "./dist/build/browser.js"
    },
    "./build/inline": {
      "types": "./dist/build/manual.d.ts",
      "default": "./dist/build/inline.js"
    },
    "./build/manual": {
      "types": "./dist/build/manual.d.ts",
      "default": "./dist/build/manual.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "pretest": "node scripts/build.ts --fault-injection",
    "test": "node --expose-gc --test \"test/**/*.test.ts\"",
    "test:types": "tsc -p tsconfig.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "test:browser": "node --test --test-force-exit test/browser-smoke.ts",
    "test:workerd": "node --test --test-force-exit test/workerd-smoke.ts",
    "test:package": "node --test test/package-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "binaryen": "132.0.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
