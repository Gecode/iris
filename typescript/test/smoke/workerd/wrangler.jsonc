{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "gecode-iris-smoke",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  // Wrangler imports .wasm files as compiled modules by default.
  "rules": [{ "type": "Text", "globs": ["**/*.iris", "**/*.txt"], "fallthrough": false }],
}
